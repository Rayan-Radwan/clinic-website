---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const whatsappHref = "https://wa.me/34963753800";


const points = [
  { text: "Financiación hasta  (confirmar plazo)", confirmed: false },
  { text: "Sin intereses (confirmar)", confirmed: false },
  { text: "Estudio personalizado", confirmed: true },
];
---

<Layout
  title="Financiación | Clínica Dental Dra. Mª Jesús Crespo"
  description="Planes de pago adaptados a ti. Cuida tu salud bucodental sin agobios económicos."
>
  <Navbar />

  <section class="financing">
    <div class="fin-copy">
      <span class="tag-pill">
        <span class="ic"><i class="ti ti-wallet" style="font-size:11px"></i></span>
        FINANCIACIÓN
      </span>
      <h1>Tu tratamiento, a tu ritmo</h1>
      <p class="fin-p">
        Cuidar tu salud bucodental no debería ser una cuestión de dinero. Por eso te
        ponemos facilidades para que puedas pagarlo poco a poco, sin agobios.
      </p>
      <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-primary">
        <i class="ti ti-brand-whatsapp"></i> Pide información
      </a>
    </div>

    <div class="fin-visual">
      <div class="backdrop-shape"></div>
      <div class="info-card">
        <h2>Pago flexible, sin renunciar a nada</h2>
        <p>
          Estudiamos tu caso y te proponemos un plan de pago adaptado a ti, para que
          empieces tu tratamiento cuando lo necesites y lo abones cómodamente en cuotas.
        </p>
        <span class="offers-label">Qué te ofrecemos:</span>
        <ul class="offers-list">
          {points.map((p) => (
            <li>
              <i class="ti ti-check"></i>
              <span>{p.text}</span>
              {!p.confirmed && <em class="pending">pendiente de confirmar</em>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .financing{
    max-width:1180px; margin:0 auto; padding:70px 32px 100px;
    display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:start;
  }

  .tag-pill{
    font-family: var(--font-display); display:inline-flex; align-items:center; gap:8px;
    background:var(--warm-gray-20);
    padding:8px 16px 8px 8px; border-radius:999px;
    font-size:11.5px; font-weight:600; letter-spacing:.8px; color:var(--navy);
    margin-bottom:22px;
  }
  .tag-pill .ic{
    width:22px; height:22px; border-radius:50%; background:var(--pastel);
    display:flex; align-items:center; justify-content:center; font-size:12px;
  }

  .fin-copy h1{
    font-family:var(--font-serif); font-weight:500; letter-spacing:-1.2px;
    font-size:clamp(30px,3.6vw,44px); line-height:1.15; color:var(--navy-deep); margin:0 0 18px;
  }
  .fin-p{
    font-family:var(--font-serif); font-size:16px; line-height:1.65; color:#5b6577; margin:0 0 32px;
  }
  .btn-primary{
    display:inline-flex; align-items:center; gap:10px;
    background:#25D366; color:#fff; padding:15px 26px; border-radius:999px;
    font-family:var(--font-display); font-size:14.5px; font-weight:700;
    box-shadow:0 12px 26px rgba(37,211,102,.24); transition:transform .2s;
  }
  .btn-primary:hover{ transform:translateY(-2px); }

  .fin-visual{ position:relative; }
  .backdrop-shape{
    position:absolute; top:6%; right:-6%; width:88%; height:92%;
    background:var(--pastel); opacity:.5; border-radius:32px;
    transform:rotate(4deg); z-index:0;
  }
  .info-card{
    position:relative; z-index:1;
    background:var(--white); border-radius:28px; padding:36px 32px;
    box-shadow:0 30px 60px -20px rgba(20,31,52,.22);
  }
  .info-card h2{
    font-family:var(--font-display); font-size:16px; font-weight:800;
    color:var(--navy-deep); margin:0 0 14px;
  }
  .info-card p{
    font-family:var(--font-serif); font-size:14.5px; line-height:1.65;
    color:#5b6577; margin:0 0 26px;
  }
  .offers-label{
    display:block; font-family:var(--font-display); font-size:11.5px; font-weight:800;
    letter-spacing:.6px; color:var(--warm-gray); text-transform:uppercase; margin-bottom:14px;
  }
  .offers-list{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:14px; }
  .offers-list li{
    display:flex; flex-wrap:wrap; align-items:center; gap:8px;
    font-family:var(--font-display); font-size:13.5px; font-weight:600; color:var(--navy-deep);
  }
  .offers-list i{
    width:22px; height:22px; border-radius:50%; flex:none;
    background:var(--pastel); color:var(--navy);
    display:flex; align-items:center; justify-content:center; font-size:12px;
  }
  .pending{
    font-family:var(--font-serif); font-style:italic; font-size:11.5px;
    color:#b45309; background:#fef3c7; padding:3px 10px; border-radius:999px;
  }

  @media (max-width:900px){
    .financing{ grid-template-columns:1fr; gap:40px; }
    .fin-visual{ max-width:460px; margin:0 auto; }
  }
</style>