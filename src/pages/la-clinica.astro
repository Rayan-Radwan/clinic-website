---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const founder = {
  name: "Dra. María Jesús Crespo Requení",
  role: "Doctora en Odontología · Fundadora",
  bio: "Fundadora de la clínica. Licenciada y Doctora en Odontología por la Universidad de Valencia, con Máster en Patología y Terapéutica Dental y Máster en Odontología Estética y Adhesiva. Profesora asociada de Patología Dental, Odontología Conservadora y Endodoncia, y profesora del Máster en Odontología Restauradora y Endodoncia (Universidad de Valencia).",
  credentials: [
    "Licenciada y Doctora en Odontología — Universidad de Valencia",
    "Máster en Patología y Terapéutica Dental",
    "Máster en Odontología Estética y Adhesiva",
    "Profesora asociada — Universidad de Valencia",
  ],
};

const restOfTeam = [
  { name: "María José Romero Calero", role: "Prótesis e higiene bucodental", detail: "Técnico Superior en Prótesis Dental y Técnico Superior en Higiene Bucodental." },
  { name: "Sandra Sandemetrio", role: "Higienista", detail: "Higienista dental." },
];

const values = ["Trato cercano", "30 años de experiencia", "Equipo de mujeres", "Tecnología actual"];
---

<Layout
  title="La Clínica | Clínica Dental Dra. Mª Jesús Crespo"
  description="Más de 30 años cuidando la salud bucodental de Alfafar. Conoce nuestra historia, nuestro equipo y nuestras instalaciones."
>
  <Navbar />

  <!-- ===== PAGE HEADER ===== -->
  <section class="page-header">
    <span class="tag-pill">
      <span class="ic"><i class="ti ti-building-hospital" style="font-size:11px"></i></span>
      LA CLÍNICA
    </span>
    <h1>Cuidando de tu salud bucodental desde 1996.</h1>
    <p>Más de 30 años de experiencia, un equipo cercano y la tecnología de hoy. Conócenos.</p>
  </section>

  <!-- ===== NUESTRA HISTORIA ===== -->
  <section class="historia">
    <h2>Nuestra historia</h2>
    <p class="historia-text">
      Abrimos las puertas en 1996 y, desde entonces, hemos cuidado la salud bucodental de
      varias generaciones de familias de Alfafar y alrededores. En todos estos años la
      tecnología ha avanzado, pero no nuestra forma de tratarte: con cercanía, paciencia y
      la confianza de quien te conoce. Hoy somos una clínica renovada, con instalaciones y
      equipos actuales para diagnósticos precisos y tratamientos más cómodos. Nuestras
      profesionales cuidan tu sonrisa con cercanía y rigor, explicándote cada paso y
      acompañándote en todo el proceso.
    </p>
    <ul class="values-line">
      {values.map((v) => <li>{v}</li>)}
    </ul>
  </section>

  <!-- ===== NUESTRO EQUIPO ===== -->
  <section class="team-section" id="equipo">
    <div class="shead">
      <span class="tag-pill">
        <span class="ic"><i class="ti ti-users" style="font-size:11px"></i></span>
        NUESTRO EQUIPO
      </span>
      <h2>Las personas que cuidan de ti</h2>
    </div>

    <div class="founder">
      <div class="founder-frame">
        <div class="frame-backdrop"></div>
        <div class="frame-photo">
          <!-- swap for real portrait once ready -->
        </div>
      </div>
      <div class="founder-copy">
        <h3>{founder.name}</h3>
        <p class="founder-role">{founder.role}</p>
        <p class="founder-bio">{founder.bio}</p>
        <ul class="credentials">
          {founder.credentials.map((c) => (
            <li><i class="ti ti-certificate"></i> {c}</li>
          ))}
        </ul>
      </div>
    </div>

    <ul class="team-grid">
      {restOfTeam.map((member) => (
        <li class="team-card">
          <div class="team-photo">
            <!-- swap for real portrait once ready -->
          </div>
          <h4>{member.name}</h4>
          <span class="team-role">{member.role}</span>
          <p>{member.detail}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ===== INSTALACIONES ===== -->
  <section class="facilities">
    <div class="shead">
      <span class="tag-pill">
        <span class="ic"><i class="ti ti-home" style="font-size:11px"></i></span>
        NUESTRAS INSTALACIONES
      </span>
      <h2>Instalaciones renovadas</h2>
      <p>Un espacio pensado para que estés a gusto. Cada detalle pensado para tu comodidad.</p>
    </div>

    <div class="facilities-grid">
      <div class="fac-photo fac-1"><!-- real clinic photo --></div>
      <div class="fac-photo fac-2"><!-- real clinic photo --></div>
      <div class="fac-photo fac-3"><!-- real clinic photo --></div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .tag-pill{
    font-family: var(--font-display); display:inline-flex; align-items:center; gap:8px;
    background:var(--warm-gray-20);
    padding:8px 16px 8px 8px; border-radius:999px;
    font-size:11.5px; font-weight:600; letter-spacing:.8px; color:var(--navy);
    margin-bottom:18px;
  }
  .tag-pill .ic{
    width:22px; height:22px; border-radius:50%; background:var(--pastel);
    display:flex; align-items:center; justify-content:center; font-size:12px;
  }

  /* ===== PAGE HEADER ===== */
  .page-header{ max-width:820px; margin:0 auto; padding:56px 32px 20px; text-align:center; }
  .page-header h1{
    font-family:var(--font-serif); font-weight:500; letter-spacing:-1.2px;
    font-size:clamp(30px,4vw,44px); line-height:1.15; color:var(--navy-deep); margin:0 0 14px;
  }
  .page-header p{
    font-family:var(--font-serif); font-size:16px; line-height:1.6; color:#5b6577; margin:0;
  }
  .page-header .tag-pill{ display:inline-flex; }

  /* ===== HISTORIA ===== */
  .historia{ max-width:820px; margin:0 auto; padding:60px 32px; }
  .historia h2{
    font-family:var(--font-display); font-size:12px; font-weight:800; letter-spacing:1.4px;
    color:var(--pastel-deep); text-transform:uppercase; margin:0 0 20px;
  }
  .historia-text{
    font-family:var(--font-serif); font-size:17px; line-height:1.75; color:var(--ink); margin:0 0 32px;
  }
  .values-line{
    display:flex; flex-wrap:wrap; gap:10px; margin:0; padding:24px 0 0;
    border-top:1px solid rgba(30,47,77,.12);
  }
  .values-line li{
    font-family:var(--font-display); font-size:12.5px; font-weight:700; color:var(--navy);
    background:var(--bone); border:1px solid rgba(30,47,77,.12);
    padding:9px 16px; border-radius:999px;
  }

  /* ===== TEAM ===== */
  .team-section{ max-width:1240px; margin:0 auto; padding:60px 32px; }
  .shead{ margin-bottom:44px; text-align:center; }
  .shead .tag-pill{ display:inline-flex; }
  .shead h2{
    font-family:var(--font-serif); font-weight:500; letter-spacing:-1px;
    font-size:clamp(26px,3.2vw,36px); color:var(--navy-deep); margin:0 0 10px;
  }
  .shead p{ font-family:var(--font-serif); font-size:15px; color:var(--warm-gray); margin:0; }

  .founder{
    display:grid; grid-template-columns:0.75fr 1.25fr; gap:56px; align-items:start;
    margin-bottom:70px; padding-bottom:60px; border-bottom:1px solid rgba(30,47,77,.1);
  }
  .founder-frame{ position:relative; height:420px; }
  .frame-backdrop{
    position:absolute; top:20px; left:-20px; width:100%; height:100%;
    background:var(--pastel); border-radius:140px 20px 20px 20px; z-index:0;
  }
  .frame-photo{
    position:relative; width:100%; height:100%; z-index:1;
    border-radius:140px 20px 20px 20px; overflow:hidden;
    box-shadow:0 26px 44px -16px rgba(20,31,52,.32);
    background:
      radial-gradient(circle at 32% 18%, rgba(255,255,255,.4), transparent 45%),
      linear-gradient(150deg, #cfe2ee 0%, #7ba6c4 55%, #3f6a89 100%);
  }
  .founder-copy h3{
    font-family:var(--font-serif); font-weight:500; letter-spacing:-.6px;
    font-size:26px; color:var(--navy-deep); margin:0 0 6px;
  }
  .founder-role{
    font-family:var(--font-display); font-size:13px; font-weight:700;
    color:var(--pastel-deep); margin:0 0 22px;
  }
  .founder-bio{
    font-family:var(--font-serif); font-size:15.5px; line-height:1.7;
    color:#5b6577; margin:0 0 26px;
  }
  .credentials{ display:flex; flex-direction:column; gap:12px; margin:0; padding:0; }
  .credentials li{
    display:flex; align-items:flex-start; gap:10px;
    font-family:var(--font-display); font-size:13px; font-weight:600; color:var(--navy-deep);
  }
  .credentials i{ color:var(--pastel-deep); font-size:16px; margin-top:1px; flex:none; }

  .team-grid{
    list-style:none; margin:0; padding:0;
    display:grid; grid-template-columns:repeat(2,1fr); gap:24px; max-width:760px; margin:0 auto;
  }
  .team-card{
    background:var(--white); border:1px solid rgba(30,47,77,.08);
    border-radius:20px; padding:24px; text-align:center;
  }
  .team-photo{
    width:88px; height:88px; border-radius:50%; margin:0 auto 16px;
    background:linear-gradient(155deg, #cfe2ee 0%, #7ba6c4 100%);
  }
  .team-card h4{ font-family:var(--font-display); font-size:15px; font-weight:700; color:var(--navy-deep); margin:0 0 4px; }
  .team-role{ display:block; font-family:var(--font-display); font-size:11.5px; font-weight:700; color:var(--pastel-deep); margin-bottom:10px; }
  .team-card p{ font-family:var(--font-serif); font-size:13px; color:var(--warm-gray); margin:0; }

  /* ===== FACILITIES ===== */
  .facilities{ max-width:1240px; margin:0 auto; padding:60px 32px 100px; }
  .facilities-grid{ display:grid; grid-template-columns:1.4fr 1fr; grid-template-rows:1fr 1fr; gap:20px; height:460px; }
  .fac-photo{ border-radius:22px; background:linear-gradient(150deg, var(--pastel) 0%, var(--pastel-deep) 100%); }
  .fac-1{ grid-row:1 / 3; }

  @media (max-width:900px){
    .founder{ grid-template-columns:1fr; gap:36px; }
    .founder-frame{ max-width:320px; margin:0 auto; height:340px; }
    .team-grid{ grid-template-columns:1fr; }
    .facilities-grid{ grid-template-columns:1fr; grid-template-rows:repeat(3,220px); height:auto; }
    .fac-1{ grid-row:auto; }
  }
</style>