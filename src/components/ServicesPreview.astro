---
const services = [
  { slug: "odontologia", icon: "ti-tooth", title: "Odontología", text: "Cuidamos y reparamos tus dientes." },
  { slug: "odontopediatria", icon: "ti-mood-kid", title: "Odontopediatría", text: "Cuidamos de la boca de los más pequeños desde su primera revisión." },
  { slug: "endodoncia", icon: "ti-first-aid-kit", title: "Endodoncia", text: "Salvamos los dientes dañados para que no tengas que perderlos." },
  { slug: "estetica-dental", icon: "ti-sparkles", title: "Estética dental", text: "Blanqueamientos, carillas y más para una sonrisa que te haga sentir bien." },
  { slug: "cirugia-implantes", icon: "ti-vaccine-bottle", title: "Cirugía e implantes", text: "Reponemos los dientes que faltan con soluciones fijas y naturales." },
  { slug: "ortodoncia", icon: "ti-align-center", title: "Ortodoncia", text: "Alineamos tus dientes a cualquier edad, por salud o por estética." },
];
---

<section class="services-preview" id="servicios-preview">
  <div class="sp-head">
    <span class="tag-pill">
      <span class="ic"><i class="ti ti-list-details" style="font-size:11px"></i></span>
      NUESTROS SERVICIOS
    </span>
    <h2>Todo lo que tu sonrisa puede necesitar</h2>
  </div>

  <ul class="sp-grid">
    {services.map((s) => (
      <li>
        <a href={`/servicios#${s.slug}`} class="sp-card">
          <div class="sp-photo">
            <!-- swap for a real treatment photo once ready -->
          </div>
          <span class="sp-icon"><i class={`ti ${s.icon}`}></i></span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .services-preview{ max-width:1240px; margin:0 auto; padding:80px 32px; }

  .sp-head{ margin-bottom:44px; }
  .tag-pill{
    font-family: var(--font-display); display:inline-flex; align-items:center; gap:8px;
    background:var(--warm-gray-20);
    padding:8px 16px 8px 8px; border-radius:999px;
    font-size:11.5px; font-weight:600; letter-spacing:.8px; color:var(--navy);
    margin-bottom:18px;
  }
  .tag-pill .ic{
    width:22px; height:22px; border-radius:50%; background:var(--pastel);
    display:flex; align-items:center; justify-content:center; font-size:12px;
  }
  .sp-head h2{
    font-family:var(--font-serif); font-weight:500; letter-spacing:-1px;
    font-size:clamp(26px,3.2vw,36px); color:var(--navy-deep); margin:0;
  }

  .sp-grid{
    list-style:none; margin:0; padding:0;
    display:grid; grid-template-columns:repeat(3,1fr); gap:22px;
  }
  .sp-card{
    display:block; background:var(--bone);
    border:1px solid rgba(30,47,77,.08); border-radius:22px; overflow:hidden;
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .sp-card:hover{ transform:translateY(-6px); box-shadow:0 20px 40px rgba(30,47,77,.12); }

  .sp-photo{
    height:140px; width:100%;
    background:
      radial-gradient(circle at 30% 20%, rgba(255,255,255,.4), transparent 45%),
      linear-gradient(150deg, var(--pastel) 0%, var(--pastel-deep) 100%);
  }

  .sp-icon{
    display:flex; align-items:center; justify-content:center;
    width:42px; height:42px; border-radius:12px;
    background:var(--navy); color:var(--white); font-size:19px;
    margin:-21px 20px 14px; position:relative; z-index:1;
    box-shadow:0 8px 16px rgba(30,47,77,.25);
  }

  .sp-card h3{
    font-family:var(--font-display); font-size:15.5px; font-weight:700;
    color:var(--navy-deep); margin:0 20px 6px;
  }
  .sp-card p{
    font-family:var(--font-serif); font-size:13.5px; line-height:1.55;
    color:var(--warm-gray); margin:0 20px 20px;
  }

  @media (max-width:900px){
    .sp-grid{ grid-template-columns:1fr 1fr; }
  }
  @media (max-width:600px){
    .sp-grid{ grid-template-columns:1fr; }
  }
</style>