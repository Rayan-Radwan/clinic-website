---
import watermark from "../assets/isotipo azul.png";

const services = [
  {
    icon: "ti-tooth",
    title: "Odontología conservadora",
    text: "Cuidamos y reparamos tus dientes con técnicas mínimamente invasivas.",
  },
  {
    icon: "ti-mood-kid",
    title: "Odontopediatría",
    text: "Cuidamos de la boca de los más pequeños, con paciencia y cercanía.",
  },
  {
    icon: "ti-first-aid-kit",
    title: "Endodoncia",
    text: "Salvamos los dientes dañados para que no tengas que perderlos.",
  },
  {
    icon: "ti-sparkles",
    title: "Estética dental",
    text: "Trabajamos en tu sonrisa para que te haga sentir bien.",
  },
  {
    icon: "ti-vaccine-bottle",
    title: "Cirugía e implantes",
    text: "Reponemos los dientes que faltan con soluciones fijas y naturales.",
  },
  {
    icon: "ti-align-center",
    title: "Ortodoncia",
    text: "Alineamos tus dientes a cualquier edad, por salud o por estética.",
  },
];
---

<section class="services" id="servicios">
  <img src={watermark.src} alt="" aria-hidden="true" class="services-watermark" />
  <div class="shead">
    <div>
      <span class="tag-pill">
        <span class="ic"><i class="ti ti-list-details" style="font-size:11px"></i></span>
        NUESTROS SERVICIOS
      </span>
      <h2 class="s-h">Todo lo que tu sonrisa<br />puede necesitar, <span class="highlight">en un mismo sitio</span></h2>
    </div>
    <p class="shead-cap">
      Seis áreas de tratamiento, un mismo equipo cercano y la misma calma
      a la hora de explicarte cada paso.
    </p>
  </div>

  <ul class="service-list">
    {services.map((s, i) => (
      <li class="service-row">
        <span class="row-index">{String(i + 1).padStart(2, "0")}</span>
        <span class="row-icon"><i class={`ti ${s.icon}`}></i></span>
        <div class="row-body">
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
        <a href="#contacto" class="row-arrow" aria-label={`Saber más sobre ${s.title}`}>
          <i class="ti ti-arrow-up-right"></i>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>


.services-watermark{
  position:absolute;
  right:-70px;
  top:270px;
  height:600px;
  width:auto;
  opacity:.05;
  transform:rotate(-15deg);
  pointer-events:none;
  user-select:none;
  z-index:0; }

.services > *:not(.services-watermark){
  position:relative;
  z-index:1; }
  .services{ position:relative; overflow:hidden;max-width:1240px; margin:0 auto; padding:80px 32px; }

  .shead{
    display:flex; justify-content:space-between; align-items:flex-end; gap:32px;
    margin-bottom:50px; flex-wrap:wrap;
  }
  .tag-pill{
    font-family: var(--font-display); display:inline-flex; align-items:center; gap:8px;
    background:var(--warm-gray-20, rgba(168,162,158,.15));
    padding:8px 16px 8px 8px; border-radius:999px;
    font-size:11.5px; font-weight:500; letter-spacing:.8px; color:var(--navy);
    margin-bottom:20px;
  }
  .tag-pill .ic{
    width:22px; height:22px; border-radius:50%; background:var(--pastel);
    display:flex; align-items:center; justify-content:center; font-size:12px;
  }
  .s-h{
    font-family:var(--font-serif); font-weight:500; letter-spacing:-1px;
    font-size:clamp(26px,3.2vw,38px); line-height:1.2; color:var(--navy-deep); margin:0; max-width:560px;
  }
  .s-h .highlight{ color:var(--pastel-deep); }
  .shead-cap{
    font-family:var(--font-serif); font-style:italic; font-size:14.5px;
    color:#5b6577; max-width:280px; text-align:right; margin:0;
  }

  .service-list{ margin:0; padding:0; border-top:1px solid rgba(30,47,77,.12); }
  .service-row{
    display:flex; align-items:center; gap:24px;
    padding:26px 12px; border-bottom:1px solid rgba(30,47,77,.12);
    transition:background .25s ease;
  }
  .service-row:hover{ background:rgba(184,212,227,.16); }

  .row-index{
    font-family:var(--font-serif); font-style:italic; font-size:15px;
    color:var(--warm-gray); width:28px; flex:none;
  }
  .row-icon{
    width:46px; height:46px; border-radius:14px; flex:none;
    background:var(--navy); color:var(--white);
    display:flex; align-items:center; justify-content:center; font-size:21px;
  }
  .row-body{ flex:1; min-width:0; }
  .row-body h3{
    font-family:var(--font-display); font-size:18px; 
    color:var(--navy-deep); margin:0 0 4px;
  }
  .row-body p{
    font-family:var(--font-serif); font-size:17px; line-height:1.55;
    color:var(--warm-gray); margin:0;
  }

  .row-arrow{
    width:42px; height:42px; border-radius:50%; flex:none;
    border:1.5px solid rgba(30,47,77,.16); color:var(--navy);
    display:flex; align-items:center; justify-content:center; font-size:17px;
    transform:translateX(0); transition:all .25s ease;
  }
  .service-row:hover .row-arrow{
    background:var(--navy); color:var(--white); border-color:var(--navy);
    transform:translateX(4px);
  }

  @media (max-width:720px){
    .shead{ flex-direction:column; align-items:flex-start; }
    .shead-cap{ text-align:left; max-width:none; }
    .service-row{ gap:14px; padding:20px 8px; flex-wrap:wrap; }
    .row-index{ display:none; }
    .row-arrow{ margin-left:auto; }
  }
</style>