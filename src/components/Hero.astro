---
const whatsappHref = "https://wa.me/34963753800";
---

<section class="hero">
  <div class="hero-copy">
    <span class="tag-pill">
      <span class="ic"><i class="ti ti-map-pin" style="font-size:11px"></i></span>
      CLÍNICA DENTAL EN ALFAFAR
    </span>

    <h1 class="hero-h">Tu sonrisa, en manos de quien la conoce</h1>

    <p class="hero-p">
      30 años acompañando a nuestros pacientes con tratamientos personalizados,
      instalaciones renovadas y un equipo especializado.
    </p>

    <div class="hero-ctas">
      <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-primary">
        <i class="ti ti-brand-whatsapp"></i> Pide cita por WhatsApp
      </a>
      <a href="/la-clinica" class="text-link">Conócenos</a>
    </div>

    <ul class="trust-line">
      <li>Desde 1996</li>
      <li>Equipo de mujeres</li>
      <li>Financiación a tu medida</li>
    </ul>
  </div>

  <div class="hero-visual">
    <div class="backdrop-blob"></div>
    <div class="photo-blob">
      <!-- swap this background for the real team photo once ready -->
    </div>
  </div>
</section>

<style>
  .hero{
    max-width:1240px; margin:0 auto; padding:38px 32px 20px;
    display:grid; grid-template-columns:1fr 0.92fr; gap:20px; align-items:center;
    position:relative;
  }

  .tag-pill{
    font-family: var(--font-display); display:inline-flex; align-items:center; gap:8px;
    background:var(--warm-gray-20);
    padding:8px 16px 8px 8px; border-radius:999px;
    font-size:11.5px; font-weight:600; letter-spacing:.8px; color:var(--navy);
    margin-bottom:24px;
  }
  .tag-pill .ic{
    width:22px; height:22px; border-radius:50%; background:var(--pastel);
    display:flex; align-items:center; justify-content:center; font-size:12px;
  }

  .hero-h{
    font-family: var(--font-serif); font-weight:500; letter-spacing:-1.4px;
    font-size:clamp(32px,4vw,50px); line-height:1.12;
    color:var(--navy-deep); margin:0 0 22px; max-width:560px;
  }

  .hero-p{
    font-family:var(--font-serif); font-size:16.5px; line-height:1.65;
    color:#5b6577; max-width:440px; margin:0 0 30px;
  }

  .hero-ctas{ display:flex; align-items:center; gap:24px; margin-bottom:34px; flex-wrap:wrap; }
  .btn-primary{
    display:inline-flex; align-items:center; gap:10px;
    background:#25D366; color:#fff;
    padding:15px 26px; border-radius:999px;
    font-family:var(--font-display); font-size:14.5px; font-weight:700;
    box-shadow:0 12px 26px rgba(37,211,102,.28);
    transition:transform .2s;
  }
  .btn-primary:hover{ transform:translateY(-2px); }

  .text-link{
    font-family:var(--font-display); font-size:13.5px; font-weight:700; color:var(--navy);
    text-decoration:underline; text-underline-offset:3px; text-decoration-color:var(--pastel-deep);
  }

  .trust-line{
    display:flex; flex-wrap:wrap; align-items:center; gap:10px;
    margin:0; padding:20px 0 0; border-top:1px solid rgba(30,47,77,.12);
    font-family:var(--font-display); font-size:12.5px; font-weight:700; color:var(--navy-deep);
  }
  .trust-line li{ display:flex; align-items:center; gap:10px; }
  .trust-line li:not(:last-child)::after{
    content:'·'; margin-left:10px; color:var(--pastel-deep); font-weight:800;
  }

  /* ===== HERO VISUAL ===== */
  .hero-visual{ position:relative; height:480px; }
  .backdrop-blob{
    position:absolute; top:6%; right:2%; width:78%; height:88%;
    background:var(--pastel); opacity:.55;
    border-radius:38% 62% 63% 37% / 41% 44% 56% 59%;
    transform:rotate(-6deg); z-index:0;
  }
  .photo-blob{
    position:absolute; top:0; right:6%; width:72%; height:84%;
    border-radius:63% 37% 54% 46% / 48% 41% 59% 52%;
    overflow:hidden; z-index:2;
    box-shadow:0 30px 50px -18px rgba(20,31,52,.35);
    background:
      radial-gradient(circle at 30% 20%, rgba(255,255,255,.4), transparent 45%),
      linear-gradient(150deg, #cfe2ee 0%, #7ba6c4 55%, #3f6a89 100%);
  }

  @media (max-width:980px){
    .hero{ grid-template-columns:1fr; }
    .hero-visual{ height:380px; max-width:420px; margin:0 auto; }
  }
</style>