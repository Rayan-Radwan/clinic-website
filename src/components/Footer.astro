---
import logoFooter from "../assets/LOGOTIPO V2.png";

const quickLinks = [
  { label: "Inicio", href: "#" },
  { label: "La Clínica", href: "#equipo" },
  { label: "Servicios", href: "#servicios" },
  { label: "Financiación", href: "#financiacion" },
  { label: "Opiniones", href: "#testimonios" },
  { label: "Contacto", href: "#contacto" },
];

const serviceLinks = [
  "Odontología conservadora",
  "Odontopediatría",
  "Endodoncia",
  "Estética dental",
  "Cirugía e implantes",
  "Ortodoncia",
];

const legalLinks = ["Aviso legal", "Política de privacidad", "Política de cookies"];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="f-brand">
     <div class="f-logo">
  <img
    src={logoFooter.src}
    alt="Clínica Dental Dra. Mª Jesús Crespo"
    class="footer-logo"
  />
</div>
      <p class="f-tag">
        Tres décadas cuidando sonrisas en Alfafar, con un equipo cercano
        que te explica cada paso con calma.
      </p>
      <div class="f-social">
        <a href="#" aria-label="Instagram"><i class="ti ti-brand-instagram"></i></a>
        <a href="#" aria-label="WhatsApp"><i class="ti ti-brand-whatsapp"></i></a>
        <a href="#" aria-label="Email"><i class="ti ti-mail"></i></a>
      </div>
    </div>

    <div class="f-col">
      <h3>Navegación</h3>
      <ul>
        {quickLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="f-col">
      <h3>Servicios</h3>
      <ul>
        {serviceLinks.map((s) => (
          <li><a href="#servicios">{s}</a></li>
        ))}
      </ul>
    </div>

    <div class="f-col f-contact">
      <h3>Visítanos</h3>
      <ul class="contact-list">
        <li><i class="ti ti-map-pin"></i> Av. de Gómez Ferrer, 49, Alfafar, Valencia</li>
        <li><i class="ti ti-phone"></i> +34 000 00 00 00</li>
        <li><i class="ti ti-clock"></i> Lun–Vie · 9:00–14:00 y 16:00–20:00</li>
      </ul>
      <a href="#contacto" class="f-cta">
        Pedir cita <span class="go"><i class="ti ti-arrow-up-right"></i></span>
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} Clínica Dental Dra. Mª Jesús Crespo. Todos los derechos reservados.</p>
    <ul class="legal-links">
      {legalLinks.map((l) => (
        <li><a href="#">{l}</a></li>
      ))}
    </ul>
    <button type="button" class="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Volver arriba">
      <i class="ti ti-arrow-up"></i>
    </button>
  </div>
</footer>

<style>
  .site-footer{
    background:var(--navy-deep);
    color:rgba(255,253,250,.85);
    padding:72px 32px 0;
  }

  .footer-top{
    max-width:1240px; margin:0 auto;
    display:grid; grid-template-columns:1.3fr 0.85fr 0.85fr 1fr; gap:48px;
    padding-bottom:56px; border-bottom:1px solid rgba(255,255,255,.1);
  }

  .f-logo{
  margin-bottom:22px;
}

.footer-logo{ height:62px; width:auto; display:block;}
f-tag{
    font-family:var(--font-serif); font-size:14px; line-height:1.65;
    color:rgba(255,253,250,.65); max-width:300px; margin:0 0 22px;
  }

  .f-social{ display:flex; gap:10px; }
  .f-social a{
    width:38px; height:38px; border-radius:50%;
    border:1.5px solid rgba(255,255,255,.18); color:var(--white);
    display:flex; align-items:center; justify-content:center; font-size:16px;
    transition:all .2s;
  }
  .f-social a:hover{ background:var(--pastel); color:var(--navy-deep); border-color:var(--pastel); }

  .f-col h3{
    font-family:var(--font-display); font-size:15px;
    letter-spacing:1.2px; color:var(--pastel); text-transform:uppercase;
    margin:0 0 20px;
  }
  .f-col ul{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:12px; }
  .f-col ul li a{
    font-family:var(--font-display); font-size:13.5px; font-weight:600;
    color:rgba(255,253,250,.75); transition:color .2s;
  }
  .f-col ul li a:hover{ color:var(--white); }

  .contact-list{ gap:14px !important; margin-bottom:24px !important; }
  .contact-list li{
    display:flex; align-items:flex-start; gap:10px;
    font-family:var(--font-serif); font-size:13.5px; line-height:1.5;
    color:rgba(255,253,250,.75);
  }
  .contact-list i{ color:var(--pastel); font-size:16px; margin-top:1px; flex:none; }

  .f-cta{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--pastel); color:var(--navy-deep);
    padding:12px 10px 12px 20px; border-radius:999px;
    font-family:var(--font-display); font-size:13px; font-weight:700;
    transition:transform .2s;
  }
  .f-cta .go{
    width:26px; height:26px; border-radius:50%;
    background:var(--navy-deep); color:var(--white);
    display:flex; align-items:center; justify-content:center;
  }
  .f-cta:hover{ transform:translateY(-2px); }

  .footer-bottom{
    max-width:1240px; margin:0 auto;
    display:flex; align-items:center; justify-content:space-between; gap:20px;
    padding:24px 0; flex-wrap:wrap;
  }
  .footer-bottom p{
    font-family:var(--font-display); font-size:12px; color:rgba(255,253,250,.5); margin:0;
  }
  .legal-links{ list-style:none; display:flex; gap:22px; margin:0; padding:0; }
  .legal-links a{
    font-family:var(--font-display); font-size:12px; color:rgba(255,253,250,.5);
    transition:color .2s;
  }
  .legal-links a:hover{ color:var(--white); }

  .back-to-top{
    width:38px; height:38px; border-radius:50%; flex:none;
    background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.15);
    color:var(--white); cursor:pointer;
    display:flex; align-items:center; justify-content:center; font-size:16px;
    transition:all .2s;
  }
  .back-to-top:hover{ background:var(--pastel); color:var(--navy-deep); border-color:var(--pastel); }

  @media (max-width:980px){
    .footer-top{ grid-template-columns:1fr 1fr; gap:40px 24px; }
    .f-brand{ grid-column:1 / -1; }
  }
  @media (max-width:560px){
    .footer-top{ grid-template-columns:1fr; }
    .footer-bottom{ flex-direction:column; align-items:flex-start; }
  }
</style>