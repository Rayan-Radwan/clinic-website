---
import logoFooter from "../assets/LOGOTIPO V2.png";

const whatsappHref = "https://wa.me/34963753800";
const mapsHref = "https://www.google.com/maps/search/?api=1&query=Avenida+G%C3%B3mez+Ferrer+49+Alfafar+Valencia";

const quickLinks = [
  { label: "Inicio", href: "/" },
  { label: "La Clínica", href: "/la-clinica" },
  { label: "Servicios", href: "/servicios" },
  { label: "Financiación", href: "/financiacion" },
  { label: "Opiniones", href: "/#testimonios" },
  { label: "Contacto", href: "/contacto" },
];

const serviceLinks = [
  { label: "Odontología conservadora", slug: "odontologia" },
  { label: "Odontopediatría", slug: "odontopediatria" },
  { label: "Endodoncia", slug: "endodoncia" },
  { label: "Estética dental", slug: "estetica-dental" },
  { label: "Cirugía e implantes", slug: "cirugia-implantes" },
  { label: "Ortodoncia", slug: "ortodoncia" },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="f-brand">
     <div class="f-logo">
  <img
    src={logoFooter.src}
    alt="Clínica Dental Dra. Mª Jesús Crespo"
    class="footer-logo"
  />
</div>
      <div class="f-social">
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><i class="ti ti-brand-whatsapp"></i></a>
        <a href="mailto:info@clinicadentalmjcrespo.es" aria-label="Email"><i class="ti ti-mail"></i></a>
      </div>
    </div>

    <div class="f-col">
      <h3>Navegación</h3>
      <ul>
        {quickLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="f-col">
      <h3>Servicios</h3>
      <ul>
        {serviceLinks.map((s) => (
          <li><a href={`/servicios#${s.slug}`}>{s.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="f-col f-contact">
      <h3>Contacto</h3>
      <ul class="brief-list">
        <li>
          <span class="bl-ic"><i class="ti ti-clock"></i></span>
          <div><b>Horario</b><p>Lun–Vie · 10:00–14:00 y 16:00–20:00</p></div>
        </li>
        <li>
          <a href="tel:+34963753800">
            <span class="bl-ic"><i class="ti ti-phone"></i></span>
            <div><b>Pide Cita</b><p>963 753 800</p></div>
          </a>
        </li>
        <li>
          <a href="mailto:info@clinicadentalmjcrespo.es">
            <span class="bl-ic"><i class="ti ti-mail"></i></span>
            <div><b>Solicita más información</b><p>info@clinicadentalmjcrespo.es</p></div>
          </a>
        </li>
        <li>
          <a href={mapsHref} target="_blank" rel="noopener noreferrer">
            <span class="bl-ic"><i class="ti ti-map-pin"></i></span>
            <div><b>Cómo llegar</b><p>Ver en el mapa</p></div>
          </a>
        </li>
      </ul>
      <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="f-cta">
        Pide cita por WhatsApp <span class="go"><i class="ti ti-arrow-up-right"></i></span>
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} Clínica Dental Dra. Mª Jesús Crespo. Todos los derechos reservados.</p>
    <button type="button" class="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Volver arriba">
      <i class="ti ti-arrow-up"></i>
    </button>
  </div>
</footer>

<style>
  .site-footer{
    background:var(--navy-deep);
    color:rgba(255,253,250,.85);
    padding:72px 32px 0;
  }

  .footer-top{
    max-width:1240px; margin:0 auto;
    display:grid; grid-template-columns:0.9fr 0.75fr 0.75fr 1.15fr; gap:40px;
    padding-bottom:52px; border-bottom:1px solid rgba(255,255,255,.1);
  }

  .f-logo{
  margin-bottom:22px;
}

.footer-logo{ height:62px; width:auto; display:block;}

  .f-social{ display:flex; gap:10px; margin-top:22px; }
  .f-social a{
    width:38px; height:38px; border-radius:50%;
    border:1.5px solid rgba(255,255,255,.18); color:var(--white);
    display:flex; align-items:center; justify-content:center; font-size:16px;
    transition:all .2s;
  }
  .f-social a:hover{ background:var(--pastel); color:var(--navy-deep); border-color:var(--pastel); }

  .f-col h3{
    font-family:var(--font-display); font-size:15px;
    letter-spacing:1.2px; color:var(--pastel); text-transform:uppercase;
    margin:0 0 20px;
  }
  .f-col ul{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:12px; }
  .f-col ul li a{
    font-family:var(--font-display); font-size:13.5px; font-weight:600;
    color:rgba(255,253,250,.75); transition:color .2s;
  }
  .f-col ul li a:hover{ color:var(--white); }

  /* ===== brief-list: icon-chip rows, matching the icon language used site-wide ===== */
  .brief-list{ gap:16px !important; margin-bottom:26px !important; }
  .brief-list li{ display:flex; align-items:flex-start; gap:12px; }
  .brief-list li a{
    display:flex; align-items:flex-start; gap:12px; width:100%;
    color:inherit; transition:opacity .2s;
  }
  .brief-list li a:hover{ opacity:.8; }
  .bl-ic{
    width:34px; height:34px; border-radius:10px; flex:none;
    background:rgba(184,212,227,.16); color:var(--pastel);
    display:flex; align-items:center; justify-content:center; font-size:15px;
  }
  .brief-list b{
    display:block; font-family:var(--font-display); font-size:11px; font-weight:800;
    letter-spacing:.4px; color:var(--pastel); text-transform:uppercase; margin-bottom:3px;
  }
  .brief-list p{
    font-family:var(--font-serif); font-size:13.5px; line-height:1.4;
    color:rgba(255,253,250,.8); margin:0;
  }

  .f-cta{
    display:inline-flex; align-items:center; gap:8px;
    background:var(--pastel); color:var(--navy-deep);
    padding:12px 10px 12px 20px; border-radius:999px;
    font-family:var(--font-display); font-size:13px; font-weight:700;
    transition:transform .2s;
  }
  .f-cta .go{
    width:26px; height:26px; border-radius:50%;
    background:var(--navy-deep); color:var(--white);
    display:flex; align-items:center; justify-content:center;
  }
  .f-cta:hover{ transform:translateY(-2px); }

  .footer-bottom{
    max-width:1240px; margin:0 auto;
    display:flex; align-items:center; justify-content:space-between; gap:20px;
    padding:24px 0; flex-wrap:wrap;
  }
  .footer-bottom p{
    font-family:var(--font-display); font-size:12px; color:rgba(255,253,250,.5); margin:0;
  }

  .back-to-top{
    width:38px; height:38px; border-radius:50%; flex:none;
    background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.15);
    color:var(--white); cursor:pointer;
    display:flex; align-items:center; justify-content:center; font-size:16px;
    transition:all .2s;
  }
  .back-to-top:hover{ background:var(--pastel); color:var(--navy-deep); border-color:var(--pastel); }

  @media (max-width:980px){
    .footer-top{ grid-template-columns:1fr 1fr; gap:40px 24px; }
    .f-brand{ grid-column:1 / -1; }
  }
  @media (max-width:560px){
    .footer-top{ grid-template-columns:1fr; }
    .footer-bottom{ flex-direction:column; align-items:flex-start; }
  }
</style>