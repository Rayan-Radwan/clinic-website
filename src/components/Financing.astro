---
const installments = ["3", "6", "12", "24"];
const activeInstallment = "12";

const steps = [
  { n: "01", title: "Pide tu presupuesto", text: "Te explicamos el tratamiento y su coste, sin compromiso." },
  { n: "02", title: "Elige tu plan", text: "Escoge el número de cuotas que mejor se adapte a ti." },
  { n: "03", title: "Empieza tu tratamiento", text: "Sin esperar a pagarlo todo por adelantado." },
];

const trustPoints = [
  { icon: "ti-percentage", text: "Sin intereses" },
  { icon: "ti-clock-check", text: "Aprobación rápida" },
  { icon: "ti-file-off", text: "Sin letra pequeña" },
];
---

<section class="financing" id="financiacion">
  <div class="fin-copy">
    <span class="tag-pill">
      <span class="ic"><i class="ti ti-wallet" style="font-size:11px"></i></span>
      FINANCIACIÓN A TU MEDIDA
    </span>

    <h2 class="fin-h">
      Cuida tu sonrisa hoy,
      <br /><span class="highlight">paga cómodamente</span> después
    </h2>

    <p class="fin-p">
      Adaptamos cada tratamiento a tu bolsillo, con planes de pago claros
      desde el primer presupuesto — sin sorpresas cuando llegue la factura.
    </p>

    <ol class="steps-row">
      {steps.map((s) => (
        <li>
          <span class="step-n">{s.n}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <ul class="trust-row">
      {trustPoints.map((t) => (
        <li><i class={`ti ${t.icon}`}></i> {t.text}</li>
      ))}
    </ul>
  </div>

  <div class="fin-visual">
    <div class="sim-card">
      <div class="sim-top">
        <span class="sim-label">Ejemplo de cuota mensual</span>
        <span class="sim-badge"><i class="ti ti-shield-check"></i> Sin intereses</span>
      </div>

      <div class="sim-amount">
        <span class="num">49€</span><span class="unit">/mes</span>
      </div>
      <p class="sim-note">Tratamiento de ejemplo · 588€ en total</p>

      <div class="sim-slider">
        <div class="track"><div class="fill"></div><span class="handle"></span></div>
      </div>

      <div class="sim-options">
        {installments.map((i) => (
          <span class:list={["opt", { active: i === activeInstallment }]}>{i} meses</span>
        ))}
      </div>

      <a href="#contacto" class="sim-cta">
        Simular mi cuota <i class="ti ti-arrow-up-right"></i>
      </a>
    </div>

    <div class="backdrop-shape"></div>
  </div>
</section>

<style>
  .financing{
    max-width:1240px; margin:0 auto; padding:80px 32px;
    display:grid; grid-template-columns:1.1fr 0.9fr; gap:64px; align-items:center;
  }

  .tag-pill{
    font-family: var(--font-display); display:inline-flex; align-items:center; gap:8px;
    background:var(--warm-gray-20, rgba(168,162,158,.15));
    padding:8px 16px 8px 8px; border-radius:999px;
    font-size:11.5px; font-weight:500; letter-spacing:.8px; color:var(--navy);
    margin-bottom:22px;
  }
  .tag-pill .ic{
    width:22px; height:22px; border-radius:50%; background:var(--pastel);
    display:flex; align-items:center; justify-content:center; font-size:12px;
  }

  .fin-h{
    font-family:var(--font-serif); font-weight:500; letter-spacing:-1px;
    font-size:clamp(28px,3.2vw,40px); line-height:1.2; color:var(--navy-deep); margin:0 0 18px;
  }
  .fin-h .highlight{ color:var(--pastel-deep); }

  .fin-p{
    font-family:var(--font-serif); font-size:16px; line-height:1.65;
    color:#5b6577; max-width:460px; margin:0 0 38px;
  }

  /* ===== STEPS ===== */
  .steps-row{ list-style:none; margin:0 0 36px; padding:0; display:flex; flex-direction:column; gap:20px; }
  .steps-row li{ display:flex; gap:16px; align-items:flex-start; }
  .step-n{
    font-family:var(--font-serif); font-style:italic; font-size:25px;
    color:var(--pastel-deep); width:34px; flex:none; line-height:1.4;
  }
  .steps-row h3{ font-family:var(--font-display); font-size:18px; font-weight:750; color:var(--navy-deep); margin:0 0 3px; }
  .steps-row p{ font-family:var(--font-serif); font-size:15px; line-height:1.5; color:var(--warm-gray); margin:0; }

  /* ===== TRUST ROW ===== */
  .trust-row{ display:flex; flex-wrap:wrap; gap:12px; margin:0; padding:0; }
  .trust-row li{
    display:flex; align-items:center; gap:8px;
    font-family:var(--font-display); font-size:13px; font-weight:700; color:var(--navy);
    background:var(--white); border:1px solid rgba(30,47,77,.14);
    padding:9px 16px; border-radius:999px;
  }
  .trust-row i{ color:var(--pastel-deep); font-size:15px; }

  /* ===== SIMULATOR CARD ===== */
  .fin-visual{ position:relative; }
  .backdrop-shape{
    position:absolute; top:6%; right:-6%; width:88%; height:92%;
    background:var(--pastel); opacity:.5; border-radius:32px;
    transform:rotate(4deg); z-index:0;
  }
  .sim-card{
    position:relative; z-index:1;
    background:var(--white); border-radius:28px; padding:34px 30px;
    box-shadow:0 30px 60px -20px rgba(20,31,52,.28);
  }
  .sim-top{ display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; gap:10px; }
  .sim-label{ font-family:var(--font-display); font-size:11.5px; font-weight:700; color:var(--warm-gray); letter-spacing:.3px; }
  .sim-badge{
    display:flex; align-items:center; gap:5px;
    font-family:var(--font-display); font-size:10.5px; font-weight:800; color:var(--navy);
    background:var(--pastel); padding:5px 11px; border-radius:999px;
  }

  .sim-amount{ display:flex; align-items:baseline; gap:4px; margin-bottom:4px; }
  .sim-amount .num{ font-family:var(--font-serif); font-weight:600; font-size:46px; color:var(--navy-deep); }
  .sim-amount .unit{ font-family:var(--font-display); font-size:14px; font-weight:700; color:var(--warm-gray); }
  .sim-note{ font-family:var(--font-serif); font-style:italic; font-size:12.5px; color:var(--warm-gray); margin:0 0 26px; }

  .sim-slider{ margin-bottom:20px; }
  .track{
    position:relative; height:6px; border-radius:999px; background:rgba(30,47,77,.1);
  }
  .fill{
    position:absolute; left:0; top:0; bottom:0; width:60%;
    background:var(--pastel-deep); border-radius:999px;
  }
  .handle{
    position:absolute; left:60%; top:50%; transform:translate(-50%,-50%);
    width:18px; height:18px; border-radius:50%;
    background:var(--navy); border:3px solid var(--white);
    box-shadow:0 4px 10px rgba(20,31,52,.3);
  }

  .sim-options{ display:flex; gap:8px; margin-bottom:26px; }
  .opt{
    flex:1; text-align:center; font-family:var(--font-display); font-size:13px; font-weight:700;
    padding:9px 4px; border-radius:12px; color:var(--navy);
    background:var(--bone); border:1px solid rgba(30,47,77,.1);
  }
  .opt.active{ background:var(--navy); color:var(--white); border-color:var(--navy); }

  .sim-cta{
    display:flex; align-items:center; justify-content:center; gap:8px;
    width:100%; background:var(--navy); color:var(--white);
    padding:15px; border-radius:14px;
    font-family:var(--font-display); font-size:17px; font-weight:600;
    transition:transform .2s;
  }
  .sim-cta:hover{ transform:translateY(-2px); }

  @media (max-width:980px){
    .financing{ grid-template-columns:1fr; gap:44px; }
    .fin-p{ max-width:none; }
    .fin-visual{ max-width:420px; margin:0 auto; }
  }
</style>